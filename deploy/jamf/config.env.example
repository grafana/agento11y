# Deliver this file to each developer as ~/.config/agento11y/config.env with
# mode 0600. Replace every placeholder through Jamf parameter/secret handling;
# never commit a real token to the package or policy script.
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
AGENTO11Y_AUTH_TENANT_ID=<instance-id>
AGENTO11Y_AUTH_TOKEN=<access-policy-token>
AGENTO11Y_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp

# Increment this every time Jamf changes a managed setting or credential.
# `agento11y agents reconcile --json` includes it in its secret-free receipt.
AGENTO11Y_MANAGED_CONFIG_REVISION=1

# Optional fleet tags. Values here apply to every session from this device.
AGENTO11Y_TAGS=managed_by=jamf
