{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "esModuleInterop": true
  },
  "include": [
    "internal/local/web/src/**/*.ts",
    "internal/local/web/src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
