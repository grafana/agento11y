{
  "name": "@grafana/agento11y-opencode",
  "version": "0.23.0",
  "description": "OpenCode plugin for Grafana Agent Observability",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/agento11y.git",
    "directory": "plugins/opencode"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "pretypecheck": "mise run build:ts:sdk-js",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "pretest": "mise run build:ts:sdk-js",
    "test": "vitest run && node --test scripts/test-hosts.test.mjs",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.2.16",
    "@opencode/plugin": "^2.0.22"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@grafana/agento11y": "workspace:*",
    "@grafana/agento11y-core": "workspace:*",
    "@opencode-ai/plugin": "1.3.13",
    "@opencode-ai/sdk": "1.3.13",
    "@opencode/plugin": "2.0.22",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-metrics": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.1",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
