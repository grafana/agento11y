# Copy this file to agentcore/.env.local before running `agentcore dev`.

# Agent identity shown in Grafana Agent Observability.
AGENTO11Y_AGENT_NAME=agentcore-operations-demo
AGENTO11Y_AGENT_VERSION=0.1.0
AGENTO11Y_TAGS=example=bedrock-agentcore,framework=langchain
OTEL_SERVICE_NAME=agento11y-bedrock-agentcore
DEPLOYMENT_ENVIRONMENT=dev

# Amazon Bedrock model.
AGENT_MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-west-2

# Optional direct Anthropic path for local development.
# AGENT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1200

# Agent Observability generation export.
AGENTO11Y_PROTOCOL=http
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=
AGENTO11Y_CONTENT_CAPTURE_MODE=no_tool_content

# Grafana Cloud OTLP traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(OTLP_INSTANCE_ID:AGENTO11Y_AUTH_TOKEN)>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_RESOURCE_ATTRIBUTES=service.namespace=agentcore

# AgentCore's default ADOT settings target CloudWatch. Keep this true when
# exporting directly to Grafana Cloud OTLP.
DISABLE_ADOT_OBSERVABILITY=true
