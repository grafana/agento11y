# Provider keys. The canned example below does not call a model, but keep these
# here so this file matches the environment shape used by real experiment jobs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_BASE=

# Optional prompt-optimizer configuration. These match command-line flags.
# AGENTO11Y_OPTIMIZER_LLM_BASE_URL=https://api.anthropic.com/v1
# AGENTO11Y_OPTIMIZER_MODEL=claude-haiku-4-5
# AGENTO11Y_OPTIMIZER_REASONING_MODEL=claude-sonnet-5
# AGENTO11Y_OPTIMIZER_MODEL_PROVIDER=anthropic
# AGENTO11Y_OPTIMIZER_START=naive
# AGENTO11Y_OPTIMIZER_SUITE_VERSION=
# AGENTO11Y_OPTIMIZER_ROUNDS=2
# AGENTO11Y_OPTIMIZER_CANDIDATES=4
# AGENTO11Y_OPTIMIZER_RUN_ID=
# AGENTO11Y_OPTIMIZER_GRAFANA_URL=http://localhost:3000
# Keep false unless prompts and fixtures are safe to export without redaction.
# AGENTO11Y_OPTIMIZER_RECORD_CONTENT=false

# Grafana Cloud ingest plane: generations and scores.
# Copy the API URL, tenant ID, and token from Grafana Cloud Agent Observability.
AGENTO11Y_ENDPOINT=https://<your-agento11y-api-host>
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=<your-tenant-id>
AGENTO11Y_AUTH_TOKEN=<your-cloud-access-policy-token>

# Optional stored-suite control plane. Not needed for suite-free publishing.
# AGENTO11Y_GRAFANA_URL=https://<your-stack>.grafana.net
# AGENTO11Y_CONTROL_ENDPOINT=https://<your-stack>.grafana.net/api/plugins/grafana-agento11y-app/resources/eval
# AGENTO11Y_SERVICE_ACCOUNT_TOKEN=<service-account-token>

# Optional run identity.
RUN_ID=go-experiment-local
GIT_SHA=local
N_ATTEMPTS=1

# Optional stored-evaluator example configuration. The evaluator has to exist in
# your tenant already; the example does not create one. Stored-evaluator grading
# is experimental and refuses to run without the opt-in below.
# AGENTO11Y_ENABLE_EXPERIMENTAL_FEATURES=true
# EVALUATOR_ID=helpfulness
# EVALUATOR_VERSION=

# Optional: customize generated experiment links.
# AGENTO11Y_EXPERIMENT_URL_TEMPLATE={base}/a/grafana-agento11y-app/offline-experiments/experiments/{run_id}
