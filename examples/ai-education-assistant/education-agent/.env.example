# Required by the agent and LLM judge.
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GRADER_MODEL=claude-haiku-4-5-20251001

# Agent Observability ingestion: a Grafana Cloud access policy token with
# sigil:write, plus the stack ID used for basic auth.
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TOKEN=<grafana-cloud-access-policy-token>
AGENTO11Y_AUTH_TENANT_ID=<grafana-cloud-stack-id>
AGENTO11Y_GRAFANA_URL=https://<stack>.grafana.net

# Agent Observability control plane: a separate Grafana service-account token.
# This is required to publish or pull the experiment test suite.
AGENTO11Y_CONTROL_ENDPOINT=https://<stack>.grafana.net/a/grafana-agento11y-app
AGENTO11Y_SERVICE_ACCOUNT_TOKEN=<grafana-service-account-token>

GRADING_SERVICE_URL=http://127.0.0.1:18181
AGENTO11Y_AGENT_NAME=ai-education-assistant
AGENTO11Y_AGENT_VERSION=0.1.0-unsafe-advisor

# Optional OTLP export for the agent. Use the same values as grading-service/.env
# so agent and service spans land in the same Grafana stack.
OTEL_SERVICE_NAME=ai-education-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-and-access-policy-token>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
