# Grafana Cloud OTLP ingestion. The access policy token needs
# metrics:write, traces:write, and logs:write scopes.
OTEL_SERVICE_NAME=ai-education-grading-service
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instance-id-and-access-policy-token>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# Set true during the outage segment of the demo, then restart the service.
ASSIGNMENT_STORE_FAILURE=false
ASSIGNMENT_STORE_FAILURE_STUDENT_ID=demo-student-outage

# Local-only API used by the experiment runner. Leave disabled otherwise.
ENABLE_TEST_FIXTURES=false
