# Copy this file to agentcore/.env.local before running
# `agentcore dev --no-traces`.

# Agent identity shown in Grafana Agent Observability.
AGENT_NAME=agentcore-otlp-demo
AGENT_VERSION=0.1.0
OTEL_SERVICE_NAME=agentcore-otlp-demo
DEPLOYMENT_ENVIRONMENT=dev

# Amazon Bedrock model.
AGENT_MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-west-2

# Optional direct Anthropic path for local development.
# AGENT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1200

# What the spans record. One of: metadata_only, no_tool_content, full.
# no_tool_content keeps full generation messages, including tool arguments and
# results, but omits those payloads from separate tool spans. full includes them
# on tool spans too. metadata_only omits message content and tool-span payloads.
AGENTO11Y_CONTENT_CAPTURE_MODE=no_tool_content

# Grafana Cloud OTLP traces and metrics. The access policy token needs traces:write
# and, for the custom metrics, metrics:write.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(OTLP_INSTANCE_ID:OTLP_TOKEN)>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_RESOURCE_ATTRIBUTES=service.namespace=agentcore

# AgentCore's default ADOT settings target CloudWatch. Keep this true when
# exporting directly to Grafana Cloud OTLP.
DISABLE_ADOT_OBSERVABILITY=true
