# Agent Observability API URL. See the Grafana Cloud Agent Observability getting started docs:
# https://grafana.com/docs/grafana-cloud/machine-learning/agent-observability/get-started/grafana-cloud/
# Copy the API URL from Observability → Agent Observability → Configuration.
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
AGENTO11Y_CONVERSATION_ID=agento11y-strands-demo

# Numeric instance ID. Used as the basic-auth user and X-Scope-OrgID tenant.
AGENTO11Y_AUTH_TENANT_ID=

# Cloud Access Policy Token (`glc_…`) with `sigil:write` scope (basic-auth password).
AGENTO11Y_AUTH_TOKEN=

# OTel metrics export. This is separate from AGENTO11Y_ENDPOINT above.
# Copy the endpoint and authentication header from Cloud portal -> stack -> OpenTelemetry.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp/v1/metrics
# The HEADERS value may be copied exactly as provided by the setup page:
# Authorization=Basic <base64 of OTLP_INSTANCE_ID:OTLP_TOKEN>
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of OTLP_INSTANCE_ID:OTLP_TOKEN>
# Alternative inputs if constructing the header yourself; the example does not log these.
# OTEL_EXPORTER_OTLP_TENANT_ID=
# OTEL_EXPORTER_OTLP_KEY=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=1000
OTEL_SERVICE_NAME=agento11y-strands-example

# The example uses Strands' OpenAI model provider by default.
STRANDS_MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# To use Strands' default Bedrock model instead:
# STRANDS_MODEL_PROVIDER=bedrock
# AWS_PROFILE=
# AWS_REGION=us-west-2
