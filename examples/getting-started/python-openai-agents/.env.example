# Both variants: OpenAI model calls. Tools use only the in-file demo data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Reused across both turns. Change this to start a separate conversation.
# main_otel.py uses this as RunConfig.group_id; main_agento11y.py uses run context.
AGENTO11Y_CONVERSATION_ID=openai-agents-support-demo

# Both variants: OTel traces and metrics, separate from generation export below.
# Copy the endpoint and authentication header from Cloud portal -> stack -> OpenTelemetry.
# https://grafana.com/docs/grafana-cloud/send-data/otlp/send-data-otlp/
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# Optional full signal-specific endpoints; leave unset to append /v1/traces or /v1/metrics.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp/v1/metrics
# Copy the HEADERS value from the setup page, including any URL encoding.
# OTLP instance ID can differ from the Agent Observability instance ID below.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of OTLP_INSTANCE_ID:OTLP_TOKEN>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL_MILLIS=1000
OTEL_SERVICE_NAME=agento11y-openai-agents-example

# Variant 1 (main_otel.py) ONLY: opt in standard GenAI chat spans as generations.
# The script appends agento11y.record=true to existing resource attributes itself.
# If configuring it yourself, append rather than replace other resource attributes.
# OTEL_RESOURCE_ATTRIBUTES=agento11y.record=true
# Do NOT set agento11y.record=true for variant 2: it already exports generations,
# so opting in its OTel spans as well can create duplicate generations.
# Variant 1 defaults to span_only: prompts/responses become SPAN attributes.
# Chat spans become generations; invoke_agent spans have no provider/model labels.
# Event/log-only capture does not populate the preview conversation view.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_only

# Variant 2 (main_agento11y.py) ONLY: Agent Observability generation export API.
# https://grafana.com/docs/grafana-cloud/machine-learning/agent-observability/get-started/grafana-cloud/
# Copy the API URL from Observability -> Agent Observability -> Configuration.
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_ENDPOINT=https://agento11y-prod-<region>.grafana.net
# Numeric instance ID, used as the basic-auth user and X-Scope-OrgID tenant.
AGENTO11Y_AUTH_TENANT_ID=
# Cloud Access Policy Token with sigil:write scope (basic-auth password).
AGENTO11Y_AUTH_TOKEN=
AGENTO11Y_AGENT_VERSION=dev
